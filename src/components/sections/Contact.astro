---
import DitherCanvas from '@/components/fx/DitherCanvas.astro';
import Icon from '@/components/ui/Icon.astro';
import { hasWhatsapp, mailtoLink, site, whatsappLink, messages } from '@/config/site';
import type { IconName } from '@/lib/icons';

const channels = [
  hasWhatsapp && {
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: site.contact.phoneDisplay,
    href: whatsappLink(messages.talk),
  },
  {
    icon: 'mail',
    label: 'E-mail',
    value: site.contact.email,
    href: mailtoLink('Contato pelo site'),
  },
  site.social.instagram && {
    icon: 'instagram',
    label: 'Instagram',
    value: '@' + site.social.instagram.replace(/\/$/, '').split('/').pop(),
    href: site.social.instagram,
  },
].filter(Boolean) as { icon: IconName; label: string; value: string; href: string }[];

const segmentsOptions = ['Supermercado', 'Loja de materiais de construção', 'Outro varejo'];
---

<section id="contato" class="cv relative px-3 py-16 sm:px-6 sm:py-24" aria-labelledby="contato-titulo">
  <div class="cta relative mx-auto max-w-6xl overflow-hidden rounded-[2rem] border border-mist/[0.08] bg-ink-850 sm:rounded-[2.5rem]" data-anim data-dither-host>
    <DitherCanvas class="absolute inset-0 h-full w-full" cell={2} density={0.9} focus="0.74,0.5" speed={0.8} />
    <div class="cta-veil absolute inset-0" aria-hidden="true"></div>

    <div class="relative grid gap-12 px-5 py-14 sm:px-10 sm:py-16 lg:grid-cols-[1fr_1.05fr] lg:gap-14 lg:px-14 lg:py-20">
      <div class="flex flex-col">
        <span class="pill self-start" data-reveal><span class="live-dot"></span> Vamos conversar</span>
        <h2
          id="contato-titulo"
          class="mt-7 text-[2.3rem] leading-[1.03] font-extrabold tracking-[-0.04em] text-fg sm:text-5xl lg:text-[3.4rem]"
          data-reveal
          style="--d: 60"
        >
          Pronto para colocar sua loja <span class="text-gradient">no controle</span><span class="punct">?</span>
        </h2>
        <p class="mt-6 max-w-md text-base leading-relaxed text-fg-muted sm:text-lg" data-reveal style="--d: 120">
          Conte um pouco sobre o seu negócio e agende uma demonstração sem compromisso. A gente entende sua operação e mostra o
          caminho.
        </p>

        <ul class="mt-9 flex flex-col gap-3" data-reveal style="--d: 180">
          {
            channels.map((c) => (
              <li>
                <a
                  href={c.href}
                  class="group flex items-center gap-4 rounded-2xl border border-mist/[0.07] bg-mist/[0.03] p-3.5 pr-5 transition-colors hover:border-mist/20 hover:bg-mist/[0.06]"
                  {...(c.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class:list={['inline-grid size-11 place-items-center rounded-xl', c.icon === 'whatsapp' ? 'bg-whatsapp/15 text-whatsapp' : 'bg-accent-2/12 text-accent-2']}>
                    <Icon name={c.icon} size={20} />
                  </span>
                  <span class="min-w-0">
                    <span class="block text-xs text-fg-subtle">{c.label}</span>
                    <span class="block truncate font-semibold text-fg">{c.value}</span>
                  </span>
                  <Icon
                    name="arrow-up-right"
                    size={18}
                    class="ml-auto text-fg-subtle transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-fg"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <form
        class="contact-form rounded-3xl border border-mist/10 bg-ink-900/70 p-5 shadow-2xl shadow-black/30 backdrop-blur-xl sm:p-7"
        data-contact-form
        data-whatsapp={hasWhatsapp ? site.contact.whatsapp : ''}
        data-email={site.contact.email}
        novalidate
        data-reveal
        style="--d: 120"
      >
        <p class="font-display text-xl font-bold tracking-[-0.02em] text-fg">Agende sua demonstração</p>
        <p class="mt-1.5 text-sm text-fg-muted">
          {hasWhatsapp ? 'Respondemos pelo WhatsApp, no melhor horário para você.' : 'Retornamos o contato no melhor horário para você.'}
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="field">
            <label for="f-nome">Seu nome</label>
            <input id="f-nome" name="nome" type="text" autocomplete="name" required placeholder="Ex.: Maria Souza" />
            <p class="error" id="erro-nome">Conta pra gente o seu nome.</p>
          </div>
          <div class="field">
            <label for="f-empresa">Empresa <span>(opcional)</span></label>
            <input id="f-empresa" name="empresa" type="text" autocomplete="organization" placeholder="Nome da loja" />
          </div>
          <div class="field sm:col-span-2">
            <label for="f-telefone">Seu WhatsApp ou telefone <span>(opcional)</span></label>
            <input id="f-telefone" name="telefone" type="tel" autocomplete="tel" inputmode="tel" placeholder="(00) 00000-0000" />
          </div>
          <div class="field sm:col-span-2">
            <span class="label" id="f-segmento-label">Segmento</span>
            <div class="chips" role="radiogroup" aria-labelledby="f-segmento-label">
              {
                segmentsOptions.map((opt, i) => (
                  <label class="chip">
                    <input type="radio" name="segmento" value={opt} checked={i === 0} />
                    <span>{opt}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <div class="field sm:col-span-2">
            <label for="f-mensagem">Como podemos ajudar? <span>(opcional)</span></label>
            <textarea
              id="f-mensagem"
              name="mensagem"
              rows="3"
              placeholder="Ex.: tenho 3 caixas e quero integrar a balança ao PDV."></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-lg mt-6 w-full">
          <Icon name={hasWhatsapp ? 'whatsapp' : 'mail'} size={19} />
          {hasWhatsapp ? 'Enviar pelo WhatsApp' : 'Enviar mensagem'}
        </button>
        <p class="mt-3 text-center text-xs text-fg-subtle" data-form-status aria-live="polite">
          {
            hasWhatsapp
              ? 'Abrimos o WhatsApp com a mensagem pronta — é só enviar.'
              : 'Abrimos o seu e-mail com a mensagem pronta — é só enviar.'
          }
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .cta {
    box-shadow: 0 40px 120px -40px rgb(0 0 0 / 0.6);
  }
  /* véu: deixa o lado do texto limpo e o dither aparecer atrás do formulário (vidro) */
  .cta-veil {
    background:
      linear-gradient(90deg, var(--ink-850) 0%, color-mix(in oklab, var(--ink-850) 88%, transparent) 38%, transparent 70%),
      radial-gradient(ellipse 80% 90% at 75% 50%, transparent 30%, color-mix(in oklab, var(--ink-850) 80%, transparent) 90%);
  }
  @media (width < 64rem) {
    .cta-veil {
      background: color-mix(in oklab, var(--ink-850) 82%, transparent);
    }
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .field label,
  .field .label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg);
  }
  .field label span {
    font-weight: 400;
    color: var(--fg-subtle);
  }
  .field input:is([type='text'], [type='tel']),
  .field textarea {
    width: 100%;
    border-radius: 0.85rem;
    border: 1px solid var(--hairline-strong);
    background: color-mix(in oklab, var(--mist) 3%, transparent);
    padding: 0.8rem 0.95rem;
    font-size: 1rem;
    color: var(--fg);
    transition:
      border-color 0.2s,
      box-shadow 0.2s,
      background-color 0.2s;
  }
  .field textarea {
    resize: vertical;
    min-height: 5.5rem;
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--fg-subtle);
  }
  .field input:hover,
  .field textarea:hover {
    border-color: color-mix(in oklab, var(--mist) 25%, transparent);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent-2);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent-2) 18%, transparent);
    background: color-mix(in oklab, var(--mist) 5%, transparent);
  }
  .field input[aria-invalid='true'] {
    border-color: var(--color-danger);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-danger) 15%, transparent);
  }
  .error {
    display: none;
    font-size: 0.8rem;
    color: var(--color-danger);
  }
  .field:has([aria-invalid='true']) .error {
    display: block;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-flex;
    padding: 0.55rem 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--hairline-strong);
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--fg-muted);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  .chip:hover span {
    color: var(--fg);
  }
  .chip input:checked + span {
    color: var(--fg);
    border-color: color-mix(in oklab, var(--accent-2) 55%, transparent);
    background: color-mix(in oklab, var(--accent-2) 12%, transparent);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--accent-2);
    outline-offset: 2px;
  }
</style>

<script>
  import { initContactForm } from '@/scripts/contact';
  initContactForm();
</script>
