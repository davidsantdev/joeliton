---
import Logo from '@/components/brand/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { hasWhatsapp, mailtoLink, messages, nav, site, whatsappLink } from '@/config/site';
import { features } from '@/data/content';
import type { IconName } from '@/lib/icons';

const socials = (
  [
    { icon: 'instagram', label: 'Instagram', href: site.social.instagram },
    { icon: 'facebook', label: 'Facebook', href: site.social.facebook },
    { icon: 'linkedin', label: 'LinkedIn', href: site.social.linkedin },
  ] as { icon: IconName; label: string; href: string }[]
).filter((s) => s.href);

const solutionLinks = features.slice(0, 6).map((f) => ({ label: f.title, href: '#solucoes' }));
const year = new Date().getFullYear();
---

<footer class="relative border-t hairline bg-ink-950/60">
  <div class="container-x py-16">
    <div class="grid grid-cols-2 gap-10 md:grid-cols-12">
      <div class="col-span-2 md:col-span-4">
        <a href="#inicio" class="inline-flex rounded-lg" aria-label="J&E Soluções — voltar ao início">
          <Logo size={32} />
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-fg-muted">
          Tecnologia e automação comercial para supermercados, lojas de materiais de construção e todo o varejo.
        </p>
        {
          socials.length > 0 && (
            <div class="mt-6 flex gap-2.5">
              {socials.map((s) => (
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.label}
                  class="inline-grid size-10 place-items-center rounded-xl border border-mist/10 bg-mist/[0.03] text-fg-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-accent-2/40 hover:text-accent-2"
                >
                  <Icon name={s.icon} size={18} />
                </a>
              ))}
            </div>
          )
        }
      </div>

      <nav class="md:col-span-2" aria-label="Navegação do rodapé">
        <p class="font-display text-sm font-semibold text-fg">Navegação</p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {
            [{ label: 'Início', href: '#inicio' }, ...nav, { label: 'Contato', href: '#contato' }].map((l) => (
              <li>
                <a href={l.href} class="text-fg-muted transition-colors hover:text-fg">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-3">
        <p class="font-display text-sm font-semibold text-fg">Soluções</p>
        <ul class="mt-4 flex flex-col gap-2.5 text-sm">
          {
            solutionLinks.map((l) => (
              <li>
                <a href={l.href} class="text-fg-muted transition-colors hover:text-fg">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="col-span-2 md:col-span-3">
        <p class="font-display text-sm font-semibold text-fg">Contato</p>
        <ul class="mt-4 flex flex-col gap-3 text-sm text-fg-muted">
          {hasWhatsapp && (
          <li>
            <a
              href={whatsappLink(messages.talk)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2.5 transition-colors hover:text-fg"
            >
              <Icon name="whatsapp" size={16} class="text-whatsapp" />
              {site.contact.phoneDisplay}
            </a>
          </li>
          )}
          <li>
            <a href={mailtoLink()} class="inline-flex items-center gap-2.5 break-all transition-colors hover:text-fg">
              <Icon name="mail" size={16} class="shrink-0 text-accent-2" />
              {site.contact.email}
            </a>
          </li>
          {
            site.contact.location && (
              <li class="inline-flex items-center gap-2.5">
                <Icon name="map-pin" size={16} class="text-accent-2" />
                {site.contact.location}
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t hairline pt-8 text-sm text-fg-subtle sm:flex-row">
      <p>
        {`© ${year} ${site.name}. Todos os direitos reservados.`}
        {site.legal.cnpj && <span class="ml-1">CNPJ {site.legal.cnpj}</span>}
      </p>
      <a href="#inicio" class="group inline-flex items-center gap-2 transition-colors hover:text-fg">
        Voltar ao topo
        <span class="inline-grid size-7 place-items-center rounded-full border border-mist/10 transition-transform duration-300 group-hover:-translate-y-0.5">
          <Icon name="arrow-up-right" size={14} class="-rotate-45" />
        </span>
      </a>
    </div>
  </div>
</footer>
