---
import { Image } from 'astro:assets';
import logoMark from '@/assets/brand/logo-mark.png';

interface Props {
  /** Altura da marca (nuvem) em px */
  size?: number;
  class?: string;
  /** Exibe "J&E Soluções" ao lado da marca */
  wordmark?: boolean;
  eager?: boolean;
}

const { size = 30, class: className, wordmark = true, eager = false } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <Image
    src={logoMark}
    alt={wordmark ? '' : 'J&E Soluções'}
    height={size}
    densities={[1, 2, 3]}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    class="logo-mark h-auto w-auto shrink-0"
    style={`height:${size}px`}
  />
  {
    wordmark && (
      <span class="inline-flex items-baseline gap-[0.3em] font-display text-[1.06rem] leading-none tracking-[-0.02em] whitespace-nowrap text-fg">
        <span class="font-extrabold">
          J<span class="text-gradient">&amp;</span>E
        </span>{' '}
        <span class="font-medium text-fg-muted">Soluções</span>
      </span>
    )
  }
</span>

<style>
  /* No tema escuro, a ponta azul-profunda do logo some no fundo: um leve brilho resolve. */
  :global(:root:not([data-theme='light'])) .logo-mark {
    filter: brightness(1.18) saturate(1.08) drop-shadow(0 0 10px rgb(80 170 240 / 0.25));
  }
</style>
