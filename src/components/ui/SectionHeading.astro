---
/**
 * Cabeçalho padrão de seção: eyebrow + título (slot) + subtítulo.
 * O título vem por slot para permitir <span class="text-gradient"> no meio da frase.
 */
interface Props {
  eyebrow?: string;
  subtitle?: string;
  align?: 'center' | 'left';
  id?: string;
  class?: string;
}

const { eyebrow, subtitle, align = 'center', id, class: className } = Astro.props;
const centered = align === 'center';
---

<div class:list={['flex flex-col gap-5', centered ? 'items-center text-center' : 'items-start', className]}>
  {
    eyebrow && (
      <span class="eyebrow" data-reveal>
        {eyebrow}
      </span>
    )
  }
  <h2
    id={id}
    class="max-w-3xl text-[2.15rem] leading-[1.06] font-bold tracking-[-0.035em] text-fg sm:text-5xl md:text-[3.25rem]"
    data-reveal
    style="--d: 60"
  >
    <slot />
  </h2>
  {
    subtitle && (
      <p
        class:list={['max-w-xl text-base leading-relaxed text-fg-muted sm:text-lg', centered && 'mx-auto']}
        data-reveal
        style="--d: 120"
      >
        {subtitle}
      </p>
    )
  }
</div>
