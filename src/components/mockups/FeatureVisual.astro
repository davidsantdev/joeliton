---
/**
 * Mini-interfaces ilustrativas dos cards de Soluções.
 * Decorativas (aria-hidden): o conteúdo real do card está no título e na descrição.
 */
import Icon from '@/components/ui/Icon.astro';
import type { FeatureVisual } from '@/data/content';
import { num, smoothPath, toPoints, areaPath } from '@/lib/chart';

interface Props {
  kind: FeatureVisual;
}
const { kind } = Astro.props;

const receipt = [
  { name: 'Arroz tipo 1 5 kg', qty: '1 un', total: 24.9 },
  { name: 'Banana prata', qty: '1,235 kg', total: 8.63, scale: true },
  { name: 'Leite integral 1 L', qty: '6 un', total: 28.74 },
  { name: 'Café torrado 500 g', qty: '2 un', total: 37.8 },
];
const receiptTotal = receipt.reduce((s, r) => s + r.total, 0);

const stock = [
  { name: 'Arroz tipo 1 5 kg', level: 82, qty: '164 un' },
  { name: 'Leite integral 1 L', level: 46, qty: '92 un' },
  { name: 'Cimento CP II 50 kg', level: 18, qty: '12 sc', low: true },
];

const finance = [
  { d: 'seg', in: 62, out: 38 },
  { d: 'ter', in: 54, out: 46 },
  { d: 'qua', in: 71, out: 35 },
  { d: 'qui', in: 66, out: 52 },
  { d: 'sex', in: 88, out: 41 },
  { d: 'sáb', in: 95, out: 30 },
];

const spark = [0.38, 0.82, 1.2, 1.45, 1.9, 2.3, 1.7, 1.35, 1.5, 1.8, 2.3, 2.05].map((v, i) => v * (1 + i * 0.012));
const sparkPts = toPoints(spark, { width: 240, height: 80, max: 2.6, padTop: 6, padBottom: 4 });
---

<div class:list={['fv', `fv-${kind}`]} aria-hidden="true" data-inview data-anim>
  {
    kind === 'pdv' && (
      <div class="pdv">
        <div class="scan">
          <span class="barcode" />
          <span class="laser" />
          <span class="scan-label">
            <Icon name="scan-barcode" size={15} /> Leitura ok
          </span>
        </div>
        <div class="receipt">
          <div class="receipt-head">
            <span>Caixa 02</span>
            <span class="online">
              <i /> Online
            </span>
          </div>
          <ul>
            {receipt.map((r) => (
              <li>
                <span class="r-name">
                  {r.name}
                  {r.scale && <em>balança</em>}
                </span>
                <span class="r-qty">{r.qty}</span>
                <span class="r-total">{num(r.total)}</span>
              </li>
            ))}
          </ul>
          <div class="receipt-total">
            <span>Total</span>
            <strong>R$ {num(receiptTotal)}</strong>
          </div>
          <div class="pay">
            <span class="is-on">
              <Icon name="check" size={13} strokeWidth={2.6} /> PIX
            </span>
            <span>Crédito</span>
            <span>Débito</span>
            <span class="hide-xs">Dinheiro</span>
          </div>
        </div>
      </div>
    )
  }

  {
    kind === 'stock' && (
      <ul class="stock">
        {stock.map((s, i) => (
          <li class:list={[s.low && 'is-low']} style={`--lvl:${s.level}%; --i:${i}`}>
            <div class="stock-row">
              <span class="stock-name">{s.name}</span>
              <span class="stock-qty">{s.low ? 'Repor' : s.qty}</span>
            </div>
            <span class="stock-bar">
              <i />
            </span>
          </li>
        ))}
      </ul>
    )
  }

  {
    kind === 'fiscal' && (
      <div class="fiscal">
        {[
          { doc: 'NFC-e', n: '4.912', v: 'R$ 129,90' },
          { doc: 'NF-e', n: '1.207', v: 'R$ 1.860,00' },
        ].map((d, i) => (
          <div class="doc" style={`--i:${i}`}>
            <span class="doc-ico">
              <Icon name="receipt-text" size={18} />
            </span>
            <span class="doc-main">
              <b>
                {d.doc} {d.n}
              </b>
              <small>
                {d.v} · <em>autorizada</em>
              </small>
            </span>
            <span class="stamp">
              <Icon name="check" size={14} strokeWidth={3} />
            </span>
          </div>
        ))}
      </div>
    )
  }

  {
    kind === 'finance' && (
      <div class="finance">
        <div class="bars">
          {finance.map((f, i) => (
            <div class="bar-col" style={`--in:${f.in}%; --out:${f.out}%; --i:${i}`}>
              <span class="b-in" />
              <span class="b-out" />
              <small>{f.d}</small>
            </div>
          ))}
        </div>
        <div class="legend">
          <span>
            <i class="l-in" /> Entradas
          </span>
          <span>
            <i class="l-out" /> Saídas
          </span>
        </div>
      </div>
    )
  }

  {
    kind === 'reports' && (
      <div class="reports">
        <div class="rep-head">
          <span class="rep-big">▲ 9,0%</span>
          <span class="rep-label">faturamento vs. ontem</span>
        </div>
        <svg viewBox="0 0 240 80" class="spark">
          <defs>
            <linearGradient id="fv-spark-area" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--accent-2); stop-opacity: 0.3" />
              <stop offset="1" style="stop-color: var(--accent-2); stop-opacity: 0" />
            </linearGradient>
            <linearGradient id="fv-spark-line" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" style="stop-color: var(--grad-from)" />
              <stop offset="1" style="stop-color: var(--grad-to)" />
            </linearGradient>
          </defs>
          <path d={areaPath(sparkPts, 80)} fill="url(#fv-spark-area)" />
          <path d={smoothPath(sparkPts)} class="spark-line" pathLength="1" />
        </svg>
      </div>
    )
  }

  {
    kind === 'custom' && (
      <div class="code">
        <div class="code-bar">
          <span class="lights">
            <i />
            <i />
            <i />
          </span>
          <span>reposicao-automatica.ts</span>
        </div>
        <pre><code><span class="ln" style="--i:0"><span class="c">// sob medida para a sua loja</span></span><span class="ln" style="--i:1"><span class="f">quando</span>(estoque.<span class="p">abaixoDoMinimo</span>)</span><span class="ln" style="--i:2">  .<span class="f">gerar</span>(<span class="p">pedidoDeCompra</span>)</span><span class="ln" style="--i:3">  .<span class="f">avisar</span>(<span class="s">'equipe de compras'</span>);</span><span class="ln ok" style="--i:4">✓ publicado · em produção<span class="cursor" /></span></code></pre>
      </div>
    )
  }

  {
    kind === 'cloud' && (
      <div class="cloud">
        <svg class="links" viewBox="0 0 240 120" preserveAspectRatio="none">
          <path d="M120 38 C 120 70, 40 60, 40 92" />
          <path d="M120 38 L 120 92" />
          <path d="M120 38 C 120 70, 200 60, 200 92" />
        </svg>
        <span class="node node-top">
          <Icon name="cloud-check" size={22} />
        </span>
        <span class="node d1">
          <Icon name="monitor" size={17} />
        </span>
        <span class="node d2">
          <Icon name="tablet-smartphone" size={17} />
        </span>
        <span class="node d3">
          <Icon name="smartphone" size={17} />
        </span>
      </div>
    )
  }

  {
    kind === 'support' && (
      <div class="chat">
        <p class="msg them">Consigo imprimir as etiquetas de gôndola em lote?</p>
        <p class="msg us">
          <span class="who">
            <span class="avatar">JE</span> Suporte J&amp;E
          </span>
          Consegue sim! Já deixei o atalho pronto na sua tela.
        </p>
        <span class="typing">
          <i />
          <i />
          <i />
        </span>
      </div>
    )
  }
</div>

<style>
  .fv {
    --line: var(--hairline);
    --panel: color-mix(in oklab, var(--ink-800) 75%, transparent);
    position: relative;
    height: 100%;
    font-size: 0.8rem;
    color: var(--fg);
  }

  /* ---------------- PDV ---------------- */
  .pdv {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    height: 100%;
    padding-block: 0.5rem;
  }
  .scan {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: min(100%, 22rem);
    padding: 0.7rem 0.9rem;
    border-radius: 0.9rem;
    border: 1px solid var(--line);
    background: var(--panel);
    overflow: hidden;
  }
  .barcode {
    width: 7.5rem;
    height: 2rem;
    flex-shrink: 0;
    background: repeating-linear-gradient(
      90deg,
      var(--fg) 0 2px,
      transparent 2px 4px,
      var(--fg) 4px 5px,
      transparent 5px 8px,
      var(--fg) 8px 11px,
      transparent 11px 12px
    );
    opacity: 0.75;
    border-radius: 2px;
  }
  .laser {
    position: absolute;
    top: 0.35rem;
    bottom: 0.35rem;
    left: 0.8rem;
    width: 2px;
    border-radius: 2px;
    background: var(--color-danger);
    box-shadow: 0 0 10px 2px color-mix(in oklab, var(--color-danger) 60%, transparent);
    animation: laser 2.6s var(--ease-in-out-quart) infinite alternate;
  }
  @keyframes laser {
    to {
      transform: translateX(7.5rem);
    }
  }
  .scan-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    font-weight: 600;
    color: var(--color-ok);
  }

  .receipt {
    width: min(100%, 22rem);
    padding: 1rem 1.1rem;
    border-radius: 1rem;
    border: 1px solid var(--line);
    background: var(--panel);
    box-shadow: var(--shadow-lg);
  }
  .receipt-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.7rem;
    margin-bottom: 0.4rem;
    border-bottom: 1px dashed var(--hairline-strong);
    font-weight: 600;
  }
  .online {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 500;
    color: var(--color-ok);
  }
  .online i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 99px;
    background: currentColor;
  }
  .receipt li {
    display: grid;
    grid-template-columns: 1fr auto 3.6rem;
    gap: 0.6rem;
    align-items: center;
    padding: 0.42rem 0;
    font-variant-numeric: tabular-nums;
  }
  .r-name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .r-name em {
    font-style: normal;
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1rem 0.35rem;
    border-radius: 0.3rem;
    color: var(--accent-2);
    background: color-mix(in oklab, var(--accent-2) 14%, transparent);
  }
  .r-qty {
    color: var(--fg-subtle);
  }
  .r-total {
    text-align: right;
  }
  .receipt-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-top: 0.5rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--hairline-strong);
  }
  .receipt-total span {
    color: var(--fg-muted);
  }
  .receipt-total strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.02em;
  }
  .pay {
    display: flex;
    gap: 0.4rem;
    margin-top: 0.8rem;
  }
  .pay span {
    display: inline-flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: 0.45rem 0.3rem;
    border-radius: 0.55rem;
    border: 1px solid var(--line);
    color: var(--fg-muted);
    font-weight: 500;
  }
  .pay .is-on {
    color: var(--btn-fg);
    border-color: transparent;
    background: linear-gradient(100deg, var(--btn-from), var(--btn-to));
    font-weight: 600;
  }
  @media (width < 400px) {
    .hide-xs {
      display: none !important;
    }
  }

  /* ---------------- Estoque ---------------- */
  .stock {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.95rem;
    height: 100%;
  }
  .stock-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.4rem;
  }
  .stock-name {
    color: var(--fg-muted);
  }
  .stock-qty {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .is-low .stock-qty {
    color: var(--color-warn);
  }
  .stock-bar {
    display: block;
    height: 0.45rem;
    border-radius: 99px;
    background: color-mix(in oklab, var(--mist) 8%, transparent);
    overflow: hidden;
  }
  .stock-bar i {
    display: block;
    height: 100%;
    width: var(--lvl);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--grad-from), var(--grad-to));
    transform-origin: left;
    transition: transform 1.2s var(--ease-out-expo) calc(var(--i) * 120ms + 200ms);
  }
  .is-low .stock-bar i {
    background: var(--color-warn);
  }

  /* ---------------- Fiscal ---------------- */
  .fiscal {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.6rem;
    height: 100%;
  }
  .doc {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.85rem;
    border: 1px solid var(--line);
    background: var(--panel);
    transition:
      transform 0.9s var(--ease-out-expo) calc(var(--i) * 140ms + 150ms),
      opacity 0.9s calc(var(--i) * 140ms + 150ms);
  }
  .doc-ico {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 0.6rem;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 13%, transparent);
  }
  .doc-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .doc-main b {
    font-weight: 600;
    white-space: nowrap;
  }
  .doc-main small {
    color: var(--fg-subtle);
    white-space: nowrap;
  }
  .doc-main em {
    font-style: normal;
    color: var(--color-ok);
  }
  .stamp {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
    margin-left: auto;
    border-radius: 99px;
    color: var(--color-ok);
    background: color-mix(in oklab, var(--color-ok) 14%, transparent);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-ok) 6%, transparent);
  }

  /* ---------------- Financeiro ---------------- */
  .finance {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .bars {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.6rem;
    align-items: end;
    min-height: 0;
  }
  .bar-col {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    align-items: end;
    height: 100%;
    padding-bottom: 1.2rem;
  }
  .bar-col span {
    border-radius: 4px 4px 2px 2px;
    transform-origin: bottom;
    transition: transform 1s var(--ease-out-expo) calc(var(--i) * 70ms + 150ms);
  }
  .b-in {
    height: var(--in);
    background: linear-gradient(180deg, var(--grad-to), var(--grad-from));
  }
  .b-out {
    height: var(--out);
    background: color-mix(in oklab, var(--mist) 16%, transparent);
  }
  .bar-col small {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 0.68rem;
    color: var(--fg-subtle);
  }
  .finance .legend {
    display: flex;
    gap: 1rem;
    margin-top: 0.6rem;
    font-size: 0.72rem;
    color: var(--fg-subtle);
  }
  .finance .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .finance .legend i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 3px;
  }
  .l-in {
    background: linear-gradient(180deg, var(--grad-to), var(--grad-from));
  }
  .l-out {
    background: color-mix(in oklab, var(--mist) 16%, transparent);
  }

  /* ---------------- Relatórios ---------------- */
  .reports {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
  }
  .rep-head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }
  .rep-big {
    white-space: nowrap;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-ok);
  }
  .rep-label {
    color: var(--fg-subtle);
  }
  .spark {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .spark-line {
    fill: none;
    stroke: url(#fv-spark-line);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  /* ---------------- Sob medida (código) ---------------- */
  .code {
    height: 100%;
    border-radius: 0.9rem;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink-950) 80%, transparent);
    overflow: hidden;
  }
  :global([data-theme='light']) .code {
    background: #0c1424;
    color: #e6edf8;
    --line: rgb(255 255 255 / 0.08);
  }
  .code-bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: #7f8ca5;
  }
  .lights {
    display: flex;
    gap: 0.35rem;
  }
  .lights i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.14);
  }
  .code pre {
    margin: 0;
    padding: 0.8rem 1rem 0.9rem;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 2.9vw, 0.8rem);
    line-height: 1.75;
    overflow: hidden;
  }
  .code code {
    display: flex;
    flex-direction: column;
  }
  .ln {
    white-space: pre;
    transition: opacity 0.4s calc(var(--i) * 260ms + 200ms);
  }
  .c {
    color: #6f7d96;
    font-style: italic;
  }
  .f {
    color: #6fb2ff;
  }
  .p {
    color: #8fe3f1;
  }
  .s {
    color: #9be7b6;
  }
  .ok {
    margin-top: 0.3rem;
    color: var(--color-ok);
  }
  .cursor {
    display: inline-block;
    width: 0.5rem;
    height: 1em;
    margin-left: 0.3rem;
    vertical-align: -0.15em;
    background: currentColor;
    animation: blink 1s steps(1) infinite;
  }

  /* ---------------- Nuvem ---------------- */
  .cloud {
    position: relative;
    height: 100%;
    min-height: 8rem;
  }
  .links {
    position: absolute;
    inset: 12% 8% 18%;
    width: 84%;
    height: 70%;
    overflow: visible;
  }
  .links path {
    fill: none;
    stroke: color-mix(in oklab, var(--accent-2) 45%, transparent);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    vector-effect: non-scaling-stroke;
    animation: packet 2.4s linear infinite;
  }
  .node {
    position: absolute;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.8rem;
    border: 1px solid var(--line);
    background: var(--panel);
    color: var(--fg-muted);
    translate: -50% -50%;
  }
  .node-top {
    left: 50%;
    top: 22%;
    width: 3.2rem;
    height: 3.2rem;
    color: var(--accent-2);
    border-color: color-mix(in oklab, var(--accent-2) 35%, transparent);
    box-shadow: 0 0 30px -6px color-mix(in oklab, var(--accent-2) 55%, transparent);
  }
  .d1 {
    left: 21%;
    top: 80%;
  }
  .d2 {
    left: 50%;
    top: 80%;
  }
  .d3 {
    left: 79%;
    top: 80%;
  }

  /* ---------------- Suporte ---------------- */
  .chat {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
    height: 100%;
  }
  .msg {
    max-width: 88%;
    padding: 0.55rem 0.75rem;
    border-radius: 0.9rem;
    line-height: 1.4;
    transition:
      transform 0.8s var(--ease-out-expo),
      opacity 0.8s;
  }
  .them {
    align-self: flex-start;
    border-bottom-left-radius: 0.3rem;
    background: color-mix(in oklab, var(--mist) 7%, transparent);
    color: var(--fg-muted);
  }
  .us {
    align-self: flex-end;
    border-bottom-right-radius: 0.3rem;
    background: color-mix(in oklab, var(--accent) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent) 25%, transparent);
    transition-delay: 0.5s;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-bottom: 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--accent);
  }
  .avatar {
