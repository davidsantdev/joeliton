---
/** Tela ILUSTRATIVA de frente de caixa (supermercado). Os totais batem com os itens. */
import Icon from '@/components/ui/Icon.astro';
import { num } from '@/lib/chart';

const items = [
  { code: '7891234560018', name: 'Arroz tipo 1 5 kg', qty: '1', unit: 24.9 },
  { code: 'Balança · 0412', name: 'Banana prata (kg)', qty: '1,235', unit: 6.99, weighed: true },
  { code: '7891234560025', name: 'Leite integral 1 L', qty: '6', unit: 4.79 },
  { code: '7891234560032', name: 'Café torrado 500 g', qty: '2', unit: 18.9 },
  { code: '7891234560049', name: 'Detergente 500 ml', qty: '3', unit: 2.49 },
].map((it) => {
  const q = Number(it.qty.replace(',', '.'));
  return { ...it, total: Math.round(q * it.unit * 100) / 100 };
});
const subtotal = items.reduce((s, it) => s + it.total, 0);
---

<div class="mock-wrap" data-anim>
  <div
    class="mock"
    role="img"
    aria-label="Ilustração de uma tela de frente de caixa de supermercado com cinco itens, banana pesada na balança e total de R$ 107,54"
  >
    <div class="bar">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="bar-title">PDV · Caixa 02</span>
      <span class="bar-meta">Operadora: Ana</span>
    </div>

    <div class="input">
      <Icon name="scan-barcode" size="1.25em" />
      <i class="caret"></i>
      <span>Código ou descrição do produto</span>
    </div>

    <div class="cols">
      <div class="items">
        <div class="thead"><span>Produto</span><span>Qtd</span><span>Total</span></div>
        {
          items.map((it, i) => (
            <div class:list={['tr', i === items.length - 1 && 'is-last']}>
              <span class="prod">
                <b>{it.name}</b>
                <small>
                  {it.code}
                  {it.weighed && <em>{`× R$ ${num(it.unit)}/kg`}</em>}
                </small>
              </span>
              <span class="qty">{it.qty}</span>
              <span class="tot">{num(it.total)}</span>
            </div>
          ))
        }
        <div class="status">
          <span><i></i>Balança conectada</span>
          <span><i></i>TEF / PIX prontos</span>
        </div>
      </div>

      <div class="side">
        <p class="lbl">Total da venda</p>
        <p class="total">R$ {num(subtotal)}</p>
        <p class="sub">{items.length} itens</p>
        <div class="pays">
          <span class="is-on"><Icon name="zap" size="1em" /> PIX</span>
          <span><Icon name="credit-card" size="1em" /> Crédito</span>
          <span><Icon name="credit-card" size="1em" /> Débito</span>
          <span><Icon name="wallet" size="1em" /> Dinheiro</span>
        </div>
        <span class="finish">Finalizar venda <Icon name="arrow-right" size="1em" strokeWidth={2.4} /></span>
      </div>
    </div>
  </div>
</div>

<style>
  .mock-wrap {
    container-type: inline-size;
  }
  .mock {
    --line: var(--hairline);
    font-size: clamp(8px, calc(100cqi / 44), 13px);
    border-radius: 1.3em;
    border: 1px solid var(--hairline-strong);
    background: var(--ink-850);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    color: var(--fg);
    text-align: left;
    user-select: none;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1em;
    padding: 0.85em 1.2em;
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink-800) 70%, transparent);
  }
  .lights {
    display: flex;
    gap: 0.4em;
  }
  .lights i {
    width: 0.7em;
    height: 0.7em;
    border-radius: 99px;
    background: color-mix(in oklab, var(--mist) 16%, transparent);
  }
  .bar-title {
    font-weight: 600;
  }
  .bar-meta {
    margin-left: auto;
    color: var(--fg-subtle);
    font-size: 0.9em;
  }
  .input {
    display: flex;
    align-items: center;
    gap: 0.7em;
    margin: 1em 1.2em 0.4em;
    padding: 0.75em 0.9em;
    border-radius: 0.8em;
    border: 1px solid color-mix(in oklab, var(--accent) 40%, transparent);
    background: color-mix(in oklab, var(--accent) 6%, transparent);
    color: var(--fg-subtle);
  }
  .input :global(svg) {
    color: var(--accent);
  }
  .caret {
    width: 1.5px;
    height: 1.15em;
    margin-right: -0.45em;
    background: var(--accent);
    animation: blink 1s steps(1) infinite;
  }
  .cols {
    display: grid;
    grid-template-columns: 1fr 13.5em;
  }
  .items {
    padding: 0.6em 1.2em 1em;
    min-width: 0;
  }
  .thead,
  .tr {
    display: grid;
    grid-template-columns: 1fr 3.6em 4.6em;
    gap: 0.6em;
    align-items: center;
  }
  .thead {
    padding: 0.5em 0;
    font-size: 0.8em;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .thead span:not(:first-child),
  .qty,
  .tot {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .tr {
    padding: 0.6em 0;
    border-top: 1px solid var(--line);
  }
  .tr.is-last {
    animation: pdv-new 3.6s var(--ease-out-expo) infinite;
    border-radius: 0.5em;
  }
  @keyframes pdv-new {
    0% {
      background: color-mix(in oklab, var(--accent-2) 16%, transparent);
    }
    40%,
    100% {
      background: transparent;
    }
  }
  .prod {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .prod b {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .prod small {
    display: flex;
    gap: 0.5em;
    font-size: 0.78em;
    color: var(--fg-subtle);
    font-family: var(--font-mono);
  }
  .prod em {
    font-style: normal;
    color: var(--accent-2);
  }
  .tot {
    font-weight: 600;
  }
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.2em;
    margin-top: 0.9em;
    font-size: 0.82em;
    color: var(--fg-muted);
  }
  .status span {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .status i {
    width: 0.5em;
    height: 0.5em;
    border-radius: 99px;
    background: var(--color-ok);
    box-shadow: 0 0 0 0.22em color-mix(in oklab, var(--color-ok) 22%, transparent);
  }
  .side {
    display: flex;
    flex-direction: column;
    padding: 1.1em 1.2em 1.2em;
    border-left: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink-800) 45%, transparent);
  }
  .lbl {
    font-size: 0.85em;
    color: var(--fg-muted);
  }
  .total {
    margin-top: 0.2em;
    font-family: var(--font-display);
    font-size: 2em;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .sub {
    font-size: 0.82em;
    color: var(--fg-subtle);
  }
  .pays {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.45em;
    margin-top: 1.1em;
  }
  .pays span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
    padding: 0.6em 0.4em;
    border-radius: 0.6em;
    border: 1px solid var(--line);
    font-size: 0.86em;
    color: var(--fg-muted);
  }
  .pays .is-on {
    color: var(--accent-2);
    border-color: color-mix(in oklab, var(--accent-2) 45%, transparent);
    background: color-mix(in oklab, var(--accent-2) 10%, transparent);
    font-weight: 600;
  }
  .finish {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    margin-top: auto;
    padding: 0.85em;
    border-radius: 0.8em;
    font-weight: 700;
    color: var(--btn-fg);
    background: linear-gradient(100deg, var(--btn-from), var(--btn-to));
  }
  @container (max-width: 520px) {
    .mock {
      font-size: calc(100cqi / 30);
    }
    .cols {
      grid-template-columns: 1fr;
    }
    .side {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .pays span:nth-child(n + 3) {
      display: none;
    }
    .finish {
      margin-top: 1em;
    }
    .bar-meta {
      display: none;
    }
  }
</style>
